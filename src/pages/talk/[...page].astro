---
import type { GetStaticPaths } from "astro";
import TalkCard from "../../components/TalkCard.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";
import { getTalkPosts } from "../../utils/talk-utils";
import "../../styles/talk.css";

export const getStaticPaths = (async ({ paginate }) => {
	const talks = await getTalkPosts();
	return paginate(talks, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const TALK_BASE = "/talk";
const getPageUrl = (p: number) => {
	if (p === 1) return url(`${TALK_BASE}/`);
	return url(`${TALK_BASE}/${p}/`);
};
---

<MainGridLayout title="说说" description="UpXuu 的碎碎念">
	<style>
		#main-grid { background: transparent !important; }
	</style>

	<main id="swup-container" class="transition-swup-fade">
		<div class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-[#eee] -mx-[var(--grid-margin)] md:-mx-0">
			<div class="flex items-center justify-between max-w-lg mx-auto px-4 h-12">
				<a href="/" class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-[#f0f0f0] transition -ml-1" aria-label="返回">
					<svg class="w-5 h-5" style="color: #666;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
				</a>
				<span class="font-bold text-[17px]" style="color: #444;">说说</span>
				<button class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-[#f0f0f0] transition -mr-1" aria-label="分享">
					<svg class="w-5 h-5" style="color: #666;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
				</button>
			</div>
		</div>

		<div class="talk-bg pt-5 pb-8">
			<div class="flex flex-col gap-4 max-w-lg mx-auto px-3 md:px-0">
				{
					page.data.length === 0 ? (
						<div class="text-center py-24" style="color: #bbb;">
							<div class="text-5xl mb-4">📝</div>
							<p class="text-lg font-semibold mb-1">还没有说说</p>
							<p class="text-sm">先去看看其他内容吧~</p>
						</div>
					) : (
						page.data.map((entry) => (
							<a href={`/talk/${entry.slug.replace("talk/", "")}/`} class="block">
								<TalkCard entry={entry} index={page.data.indexOf(entry)} total={page.data.length} />
							</a>
						))
					)
				}
			</div>

			{
				page.lastPage > 1 && (
					<div class="flex flex-row gap-2.5 justify-center mt-8 pb-4">
						<a href={page.url.prev ? getPageUrl(page.currentPage - 1) : ""} aria-label="上一页"
						   class:list={["w-10 h-10 rounded-xl flex items-center justify-center transition font-medium text-sm bg-white border border-[#e0e0e0] shadow-sm", {"opacity-30 pointer-events-none": !page.url.prev}]}
						   style="color: #666;">
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
						</a>
						<div class="bg-white border border-[#e0e0e0] flex flex-row rounded-xl items-center shadow-sm overflow-hidden">
							{Array.from({length: page.lastPage}, (_, i) => i + 1).map(p => {
								if (p === page.currentPage)
									return <div class="w-10 h-10 flex items-center justify-center font-bold text-sm text-white" style="background: #A0D8F1;">{p}</div>;
								return <a href={getPageUrl(p)} aria-label={`第 ${p} 页`} class="w-10 h-10 flex items-center justify-center font-medium text-sm hover:bg-[#f5f5f5] transition" style="color: #888;">{p}</a>;
							})}
						</div>
						<a href={page.url.next ? getPageUrl(page.currentPage + 1) : ""} aria-label="下一页"
						   class:list={["w-10 h-10 rounded-xl flex items-center justify-center transition font-medium text-sm bg-white border border-[#e0e0e0] shadow-sm", {"opacity-30 pointer-events-none": !page.url.next}]}
						   style="color: #666;">
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
						</a>
					</div>
				)
			}
		</div>

		<script>
			document.addEventListener('click', function(e) {
				const img = (e.target as HTMLElement).closest('.talk-content-img');
				if (!img) return;
				const src = (img as HTMLImageElement).src;
				const overlay = document.createElement('div');
				overlay.className = 'talk-overlay';
				overlay.innerHTML = `<img src="${src}" alt="" />`;
				overlay.onclick = () => overlay.remove();
				document.body.appendChild(overlay);
			});
		</script>
	</main>
</MainGridLayout>
