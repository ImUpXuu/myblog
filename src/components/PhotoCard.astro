---
interface Photo {
	thumb: string;
	full: string;
}

interface Props {
	photo: Photo;
	albumId: string;
	alt?: string;
}

const { photo, albumId, alt = "" } = Astro.props;
---

<div class="gallery-photo-card break-inside-avoid mb-3">
	<a
		data-fancybox="gallery"
		data-src={photo.full}
		data-thumb={photo.full}
		data-type="image"
		href={photo.full}
		class="block rounded-xl overflow-hidden group cursor-pointer"
	>
		<img
			src={photo.isThumb ? photo.thumb : photo.full}
			alt={alt}
			loading="lazy"
			decoding="async"
			class="lazy-img w-full h-auto object-cover transition-opacity duration-300 group-hover:scale-105"
			style="opacity: 0;"
			data-src={photo.isThumb ? photo.full : undefined}
		/>
	</a>
</div>

<script>
	document.querySelectorAll(".lazy-img").forEach((img) => {
		const el = img as HTMLImageElement;
		if (el.dataset.lazyReady) return;
		el.dataset.lazyReady = "true";

		const imgLoader = new Image();
		imgLoader.onload = () => {
			el.src = imgLoader.src;
			el.style.opacity = "1";
		};
		imgLoader.onerror = () => {
			const src = el.getAttribute("data-src");
			if (src) el.src = src;
			el.style.opacity = "1";
		};
		imgLoader.src = el.src;
	});
</script>

<style>
	.lazy-img {
		opacity: 0;
		transition: opacity 0.4s ease-out;
	}
</style>
