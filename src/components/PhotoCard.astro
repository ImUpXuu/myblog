---
interface Photo {
	thumb: string;
	full: string;
}

interface Props {
	photo: Photo;
	albumId: string;
	alt?: string;
}

const { photo, albumId, alt = "" } = Astro.props;
---

<div class="gallery-photo-card break-inside-avoid mb-3">
	<div
		data-lightbox="gallery"
		data-thumb={photo.isThumb ? photo.thumb : photo.full}
		data-href={photo.full}
		class="block rounded-xl overflow-hidden group cursor-pointer"
	>
		<img
			src={photo.isThumb ? photo.thumb : photo.full}
			data-src={photo.isThumb ? photo.full : undefined}
			alt={alt}
			loading="lazy"
			decoding="async"
			class="lazy-img w-full h-auto object-cover transition-all duration-500"
		/>
	</div>
</div>

<script>
	document.querySelectorAll(".lazy-img[data-src]").forEach((img) => {
		const el = img as HTMLImageElement;
		if (el.dataset.lazyLoaded) return;
		el.dataset.lazyLoaded = "true";

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const target = entry.target as HTMLImageElement;
						const fullSrc = target.getAttribute("data-src");
						if (!fullSrc) return;

						const loader = new Image();
						loader.onload = () => {
							target.style.transition = "filter 0.15s ease, transform 0.15s ease";
							target.style.filter = "blur(6px)";
							target.style.transform = "scale(1.03)";
							requestAnimationFrame(() => {
								requestAnimationFrame(() => {
									target.src = fullSrc;
									target.style.transition = "filter 0.4s ease, transform 0.4s ease";
									target.style.filter = "blur(0)";
									target.style.transform = "scale(1)";
								});
							});
						};
						loader.src = fullSrc;

						observer.unobserve(target);
					}
				});
			},
			{ rootMargin: "400px 0px", threshold: 0 }
		);

		observer.observe(el);
	});

	document.querySelectorAll(".lazy-img:not([data-src])").forEach((img) => {
		const el = img as HTMLImageElement;
		el.style.opacity = "1";
	});

	function initGalleryLightbox() {
		const items: { href: string; thumb?: string }[] = [];
		document.querySelectorAll("div[data-lightbox][data-href]").forEach((el) => {
			const href = el.getAttribute("data-href");
			const thumb = el.getAttribute("data-thumb") || undefined;
			if (href) items.push({ href, thumb });
		});
		if (items.length === 0) return;

		import("lightbox3").then(({ Lightbox }) => {
			const lb = Lightbox.init();

			document.querySelectorAll("div[data-lightbox][data-href]").forEach((el) => {
				if ((el as HTMLElement).dataset.lbGuard) return;
				(el as HTMLElement).dataset.lbGuard = "true";
				el.addEventListener(
					"click",
					(e) => {
						e.preventDefault();
						e.stopPropagation();
						const idx = Array.from(
							document.querySelectorAll("div[data-lightbox][data-href]")
						).indexOf(el);
						lb.open(items, { startAtIdx: idx });
					},
					true
				);
				el.style.cursor = "zoom-in";
			});
		});
	}

	initGalleryLightbox();

	if (window.swup) {
		window.swup.hooks.on("content:replace", () => {
			initGalleryLightbox();
		});
	} else {
		document.addEventListener("swup:enable", () => {
			window.swup!.hooks.on("content:replace", () => {
				initGalleryLightbox();
			});
		});
	}
</script>
