---
interface Photo {
	thumb: string;
	full: string;
}

interface Props {
	photo: Photo;
	albumId: string;
	alt?: string;
}

const { photo, albumId, alt = "" } = Astro.props;
---

<div class="gallery-photo-card break-inside-avoid mb-3">
	<div
		data-lb-src={photo.full}
		data-lb-thumb={photo.isThumb ? photo.thumb : photo.full}
		class="lb-trigger block rounded-xl overflow-hidden group cursor-pointer"
	>
		<img
			src={photo.isThumb ? photo.thumb : photo.full}
			data-src={photo.isThumb ? photo.full : undefined}
			alt={alt}
			loading="lazy"
			decoding="async"
			class="lazy-img w-full h-auto object-cover transition-all duration-500"
		/>
	</div>
</div>

<script>
	document.querySelectorAll(".lazy-img[data-src]").forEach((img) => {
		const el = img as HTMLImageElement;
		if (el.dataset.lazyLoaded) return;
		el.dataset.lazyLoaded = "true";

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const target = entry.target as HTMLImageElement;
						const fullSrc = target.getAttribute("data-src");
						if (!fullSrc) return;

						const loader = new Image();
						loader.onload = () => {
							target.style.transition = "filter 0.15s ease, transform 0.15s ease";
							target.style.filter = "blur(6px)";
							target.style.transform = "scale(1.03)";
							requestAnimationFrame(() => {
								requestAnimationFrame(() => {
									target.src = fullSrc;
									target.style.transition = "filter 0.4s ease, transform 0.4s ease";
									target.style.filter = "blur(0)";
									target.style.transform = "scale(1)";
								});
							});
						};
						loader.src = fullSrc;

						observer.unobserve(target);
					}
				});
			},
			{ rootMargin: "400px 0px", threshold: 0 }
		);

		observer.observe(el);
	});

	document.querySelectorAll(".lazy-img:not([data-src])").forEach((img) => {
		const el = img as HTMLImageElement;
		el.style.opacity = "1";
	});

	function initGallery() {
		const triggers = document.querySelectorAll(".lb-trigger");
		if (triggers.length === 0) return;

		let galleryContainer = document.getElementById("lb-gallery-pool");
		if (!galleryContainer) {
			galleryContainer = document.createElement("div");
			galleryContainer.id = "lb-gallery-pool";
			galleryContainer.style.cssText = "position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;opacity:0";
			document.body.appendChild(galleryContainer);
		}
		galleryContainer.innerHTML = "";

		const anchors: HTMLAnchorElement[] = [];
		triggers.forEach((trigger) => {
			const src = trigger.getAttribute("data-lb-src");
			const thumb = trigger.getAttribute("data-lb-thumb") || src;
			if (!src) return;
			const a = document.createElement("a");
			a.href = src;
			a.dataset.lightbox = "gallery";
			if (thumb) a.dataset.thumb = thumb;
			galleryContainer!.appendChild(a);
			anchors.push(a);
		});
		if (anchors.length === 0) return;

		import("lightbox3").then(({ Lightbox }) => {
			const lb = Lightbox.init();

			triggers.forEach((trigger, idx) => {
				if ((trigger as HTMLElement).dataset.lbReady) return;
				(trigger as HTMLElement).dataset.lbReady = "1";
				trigger.addEventListener(
					"click",
					(e) => {
						e.preventDefault();
						e.stopPropagation();
						e.stopImmediatePropagation();
						lb.open(anchors[idx]);
					},
					true
				);
			});
		});
	}

	initGallery();

	if (window.swup) {
		window.swup.hooks.on("content:replace", () => {
			initGallery();
		});
	} else {
		document.addEventListener("swup:enable", () => {
			window.swup!.hooks.on("content:replace", () => {
				initGallery();
			});
		});
	}
</script>

<style>
	.lb-trigger {
		cursor: zoom-in !important;
	}
</style>
