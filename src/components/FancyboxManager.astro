---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
---

<script>
	import { Fancybox } from "@fancyapps/ui";

	function wrapArticleImages() {
		document.querySelectorAll(".custom-md img, #post-cover img").forEach((img) => {
			const el = img as HTMLImageElement;
			if (el.closest("a[data-fancybox]")) return;
			if (el.dataset.fancybox) return;
			const src = el.src || el.getAttribute("data-src") || "";
			if (!src || src.startsWith("data:")) return;
			el.dataset.fancybox = "gallery";
		});
	}

	function bindAll() {
		wrapArticleImages();
		Fancybox.bind("[data-fancybox]", {
			groupAll: true
		});
	}

	function unbindAll() {
		Fancybox.close();
		Fancybox.unbind(document.body);
	}

	bindAll();
	document.addEventListener("swup:content:replace", () => {
		unbindAll();
		requestAnimationFrame(() => {
			requestAnimationFrame(bindAll);
		});
	});
</script>
