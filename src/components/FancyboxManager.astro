<script>
let Fancybox: any;

async function setup() {
	const selectors = [
		".custom-md img, #post-cover img",
		"[data-fancybox]",
	];

	const hasElements = selectors.some(selector => document.querySelector(selector));
	if (!hasElements) return;

	if (!Fancybox) {
		const mod = await import("@fancyapps/ui");
		Fancybox = mod.Fancybox;
	}

	const commonOptions = {
		Thumbs: { autoStart: true, showOnStart: "yes" },
		Toolbar: {
			display: {
				left: ["infobar"],
				middle: ["zoomIn", "zoomOut", "toggle1to1"],
				right: ["slideshow", "thumbs", "close"],
			},
		},
		animated: true,
		dragToClose: true,
		keyboard: {
			Escape: "close",
			ArrowRight: "next",
			ArrowLeft: "prev",
		},
		fitToView: true,
		preload: 3,
		infinite: true,
		Panzoom: { maxScale: 3, minScale: 1 },
		caption: false,
	};

	Fancybox.bind(".custom-md img, #post-cover img", {
		...commonOptions,
		groupAll: true,
		Carousel: { transition: "slide", preload: 2 },
	});

	Fancybox.bind("[data-fancybox]", commonOptions);
}

function cleanup() {
	if (Fancybox) {
		Fancybox.close();
		Fancybox.unbind(document.body);
	}
}

setup();

document.addEventListener("swup:content:replace", () => {
	cleanup();
	setup();
});

document.addEventListener("swup:visit:start", cleanup);
</script>
