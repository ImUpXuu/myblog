---
---

<div class="card-base rounded-lg overflow-hidden border border-[var(--line-color)] mb-5">
	<div class="flex items-center gap-1.5 px-3 py-2.5 border-b border-[var(--line-color)] bg-[var(--toc-bg)]">
		<span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
		<span class="w-2.5 h-2.5 rounded-full bg-yellow-400/80"></span>
		<span class="w-2.5 h-2.5 rounded-full bg-green-400/80"></span>
		<span class="text-sm font-semibold text-[var(--deep-text)] ml-2">AI概括本文内容</span>
		<span id="summary-stats" class="hidden text-[10px] text-[var(--btn-content)] ml-auto font-mono tabular-nums"></span>
	</div>
	<div class="px-4 py-4 text-base leading-relaxed bg-[var(--card-bg)] text-[var(--deep-text)]">
		<div id="summary-loading" class="flex items-center gap-1 h-5">
			<span class="inline-block w-1.5 h-4 bg-[var(--btn-content)]/20 animate-pulse rounded-sm" style="animation-delay:0s"></span>
			<span class="inline-block w-1.5 h-4 bg-[var(--btn-content)]/20 animate-pulse rounded-sm" style="animation-delay:0.15s"></span>
			<span class="inline-block w-1.5 h-4 bg-[var(--btn-content)]/20 animate-pulse rounded-sm" style="animation-delay:0.3s"></span>
			<span class="font-mono text-sm opacity-50 ml-2">正在概括...</span>
		</div>
		<div id="summary-box" class="hidden">
			<div id="summary-thinking-head" class="flex items-center gap-2 mb-1 cursor-pointer select-none" onclick="this.parentElement.querySelector('.thinking-wrap').classList.toggle('collapsed')">
				<span class="text-xs uppercase tracking-wider opacity-50 font-mono">Thinking</span>
				<span class="collapse-arrow inline-block text-[10px] opacity-50 font-mono transition-transform duration-300">▾</span>
			</div>
			<div class="thinking-wrap max-h-[300px] overflow-y-auto transition-all duration-600 ease-in-out">
				<div class="thinking-text font-mono text-xs opacity-60 leading-relaxed whitespace-pre-wrap border-l-2 border-[var(--line-color)] pl-3 min-h-[1em]"></div>
			</div>
			<div id="summary-result" class="hidden text-base leading-relaxed space-y-3"></div>
			<div id="summary-questions" class="hidden"></div>
		</div>
	</div>
</div>

<style is:global>
.thinking-wrap.collapsed { max-height: 0 !important; }

.summary-p { margin: 0.6em 0; }
.summary-p:first-child { margin-top: 0; }
.summary-p:last-child { margin-bottom: 0; }

.summary-questions-section {
	margin-top: 1rem;
	padding-top: 0.75rem;
	border-top: 1px solid var(--line-color);
}
.summary-qs-title {
	font-size: 0.875rem;
	font-weight: 600;
	color: var(--primary);
	margin-bottom: 0.5rem;
}
.q-tag {
	display: inline-block;
	padding: 0.3rem 0.7rem;
	margin: 0.25rem;
	font-size: 0.8125rem;
	border-radius: 999px;
	border: 1px solid var(--line-color);
	background: var(--toc-bg);
	color: var(--deep-text);
	cursor: pointer;
	transition: all 0.15s;
	white-space: nowrap;
}
.q-tag:hover {
	border-color: var(--primary);
	color: var(--primary);
	background: var(--card-bg);
}
.q-tag-ai {
	border-style: dashed;
}
.ai-badge {
	display: inline-block;
	font-size: 0.625rem;
	font-weight: 700;
	color: var(--primary);
	margin-left: 0.25rem;
	vertical-align: middle;
	opacity: 0.8;
}
</style>

<script>
	(function() {
		const m = window.location.pathname.match(/\/posts\/(.+?)\/?$/);
		if (!m) return;
		const slug = m[1];
		const cacheKey = `xuai-summary-v3-${slug}`;

		const loadingEl = document.getElementById('summary-loading');
		const box = document.getElementById('summary-box');
		const thinkingText = document.querySelector('.thinking-text') as HTMLElement;
		const thinkingWrap = thinkingText?.parentElement as HTMLElement | null;
		const resultEl = document.getElementById('summary-result');
		const questionsEl = document.getElementById('summary-questions');
		const statsEl = document.getElementById('summary-stats');
		if (!loadingEl || !box || !thinkingText || !thinkingWrap || !resultEl || !questionsEl || !statsEl) return;

		const startTime = Date.now();

		function scrollIntoView() {
			const rect = box.getBoundingClientRect();
			if (rect.bottom > window.innerHeight) {
				box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			}
		}

		function renderSummary(fullText: string, usageTokens?: number, modelName?: string) {
			// Strip markdown fences
			let clean = fullText.replace(/```(?:json)?\s*/gi, '').replace(/\s*```/g, '').trim();

			// Fallback: extract q object if it's outside the array
			let externalQ: string[] = [];
			const afterArray = clean.slice(clean.lastIndexOf(']') + 1);
			const qOuter = afterArray.match(/\{"q":\s*\[/);
			if (qOuter) {
				const qStart = afterArray.indexOf('{');
				let depth = 0, qEnd = -1;
				for (let i = qStart; i < afterArray.length; i++) {
					if (afterArray[i] === '{') depth++;
					if (afterArray[i] === '}') { depth--; if (depth === 0) { qEnd = i + 1; break; } }
				}
				if (qStart !== -1 && qEnd > qStart) {
					try {
						const qObj = JSON.parse(afterArray.slice(qStart, qEnd));
						if (Array.isArray(qObj.q)) externalQ = qObj.q;
					} catch {}
				}
			}

			// Extract JSON array from [ to ]
			const startB = clean.indexOf('[');
			const endB = clean.lastIndexOf(']');
			if (startB !== -1 && endB > startB) clean = clean.slice(startB, endB + 1);

			let data: any[];
			try { data = JSON.parse(clean); } catch {
				resultEl.textContent = fullText;
				resultEl.classList.remove('hidden');
				return;
			}

			const paragraphs = data.filter((d: any) => 'p' in d);
			const aiQuestions = externalQ.length ? externalQ : ((data.find((d: any) => 'q' in d)?.q as string[]) || []);

			let html = '';
			for (const item of paragraphs) {
				const esc = (item.p || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
				html += `<p class="summary-p">${esc}</p>`;
			}
			resultEl.innerHTML = html;
			resultEl.classList.remove('hidden');
			requestAnimationFrame(scrollIntoView);

			// default + AI questions
			const defaultQs = ['详细概括本文内容', '概括文章特点'];
			let qHtml = '<div class="summary-questions-section">';
			qHtml += '<div class="summary-qs-title">继续问AI</div>';
			for (const q of defaultQs) {
				const eq = q.replace(/&/g, '&amp;').replace(/'/g, '&#39;');
				qHtml += `<button class="q-tag" data-q="${eq}">${eq}</button>`;
			}
			for (const q of aiQuestions) {
				const eq = q.replace(/&/g, '&amp;').replace(/'/g, '&#39;');
				qHtml += `<button class="q-tag q-tag-ai" data-q="${eq}">${eq} <span class="ai-badge">AI</span></button>`;
			}
			qHtml += '</div>';
			questionsEl.innerHTML = qHtml;
			questionsEl.classList.remove('hidden');
			requestAnimationFrame(scrollIntoView);

			questionsEl.querySelectorAll('.q-tag').forEach(btn => {
				btn.addEventListener('click', () => {
					const q = (btn as HTMLElement).getAttribute('data-q') || '';
					if (q && (window as any).openAiChatWithQuestion) {
						(window as any).openAiChatWithQuestion(q);
					}
				});
			});

			// Stats
			const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
			const tokens = usageTokens || Math.round(fullText.length / 3);
			const mdl = modelName ? modelName.split('/').pop() + ' · ' : '';
			statsEl.textContent = `${mdl}${tokens} tokens · ${elapsed}s`;
			statsEl.classList.remove('hidden');
		}

		const cached = sessionStorage.getItem(cacheKey);
		if (cached) {
			loadingEl.classList.add('hidden');
			box.classList.remove('hidden');
			renderSummary(cached);
			return;
		}

		(async function() {
			let full = '';
			let hasContent = false;
			let usage: { completion_tokens?: number } | null = null;
			let modelName = '';

			try {
				const resp = await fetch('https://blogapi.upxuu.com/summarize', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ articleUrl: window.location.href }),
				});
				if (!resp.ok) {
					loadingEl.classList.add('hidden');
					box.classList.remove('hidden');
					resultEl.innerHTML = '<span class="opacity-70 font-mono text-sm">⚠ 你的请求速率过快，请稍后重试</span>';
					resultEl.classList.remove('hidden');
					return;
				}

				const reader = resp.body?.getReader();
				if (!reader) throw new Error('no reader');

				const decoder = new TextDecoder();
				let buf = '';

				while (true) {
					const { done, value } = await reader.read();
					if (done) break;

					buf += decoder.decode(value, { stream: true });
					const lines = buf.split('\n');
					buf = lines.pop() || '';

					for (const line of lines) {
						if (!line.startsWith('data: ')) continue;
						const data = line.slice(6).trim();
						if (data === '[DONE]') continue;
						try {
							const parsed = JSON.parse(data);
							if (!modelName && parsed.model) {
								modelName = parsed.model;
							}
							if (parsed.usage) {
								usage = parsed.usage;
								continue;
							}
							const d = parsed.choices?.[0]?.delta;
							if (d?.reasoning_content && !hasContent) {
								if (box.classList.contains('hidden')) box.classList.remove('hidden');
								thinkingText.textContent += d.reasoning_content;
								thinkingWrap.scrollTop = thinkingWrap.scrollHeight;
								scrollIntoView();
							}
							if (d?.content) {
								if (!hasContent) {
									hasContent = true;
									thinkingText.parentElement!.classList.add('collapsed');
									loadingEl.classList.add('hidden');
									box.classList.remove('hidden');
									resultEl.classList.remove('hidden');
									scrollIntoView();
								}
								full += d.content;
								resultEl.textContent = full;
							}
						} catch {}
					}
				}
				if (full) {
					sessionStorage.setItem(cacheKey, full);
					renderSummary(full, usage?.completion_tokens, modelName);
				}
			} catch {
				loadingEl.classList.add('hidden');
				box.classList.remove('hidden');
				resultEl.innerHTML = '<span class="opacity-70 font-mono text-sm">⚠ 你的请求速率过快，请稍后重试</span>';
				resultEl.classList.remove('hidden');
			}
		})();
	})();
</script>
