---
---

<div class="card-base rounded-lg overflow-hidden border border-[var(--line-color)] mb-5">
	<div class="flex items-center gap-1.5 px-3 py-2 border-b border-[var(--line-color)] bg-[var(--toc-bg)]">
		<span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
		<span class="w-2.5 h-2.5 rounded-full bg-yellow-400/80"></span>
		<span class="w-2.5 h-2.5 rounded-full bg-green-400/80"></span>
		<span class="text-[10px] text-[var(--btn-content)] ml-2 font-mono">XUUAI · 文章摘要</span>
	</div>
	<div class="px-4 py-3 text-sm leading-relaxed" style="background: #1e1e1e; color: #c0c0c0;">
		<div id="summary-loading" class="flex items-center gap-1 h-4">
			<span class="inline-block w-1.5 h-4 bg-white/20 animate-pulse rounded-sm" style="animation-delay:0s"></span>
			<span class="inline-block w-1.5 h-4 bg-white/20 animate-pulse rounded-sm" style="animation-delay:0.15s"></span>
			<span class="inline-block w-1.5 h-4 bg-white/20 animate-pulse rounded-sm" style="animation-delay:0.3s"></span>
			<span class="font-mono text-xs opacity-50 ml-2">正在概括...</span>
		</div>
		<div id="summary-box" class="hidden">
			<div id="summary-thinking-head" class="flex items-center gap-2 mb-1 cursor-pointer select-none" onclick="this.parentElement.querySelector('.thinking-wrap').classList.toggle('collapsed')">
				<span class="text-[10px] uppercase tracking-wider opacity-50 font-mono">Thinking</span>
				<span class="collapse-arrow inline-block text-[8px] opacity-50 font-mono transition-transform duration-300">▾</span>
			</div>
			<div class="thinking-wrap max-h-[300px] overflow-hidden transition-all duration-600 ease-in-out">
				<div class="thinking-text font-mono text-[11px] opacity-55 leading-relaxed whitespace-pre-wrap border-l-2 border-white/10 pl-3 min-h-[1em]"></div>
			</div>
			<div id="summary-result" class="hidden text-sm leading-relaxed"></div>
		</div>
	</div>
</div>

<style is:global>
.thinking-wrap.collapsed { max-height: 0 !important; }
</style>

<script>
	(function() {
		const m = window.location.pathname.match(/\/posts\/(.+?)\/?$/);
		if (!m) return;
		const slug = m[1];
		const cacheKey = `xuai-summary-${slug}`;

		const loadingEl = document.getElementById('summary-loading');
		const box = document.getElementById('summary-box');
		const thinkingText = document.querySelector('.thinking-text') as HTMLElement;
		const resultEl = document.getElementById('summary-result');
		if (!loadingEl || !box || !thinkingText || !resultEl) return;

		const cached = sessionStorage.getItem(cacheKey);
		if (cached) {
			loadingEl.classList.add('hidden');
			box.classList.remove('hidden');
			resultEl.textContent = cached;
			resultEl.classList.remove('hidden');
			return;
		}

		(async function() {
			let full = '';
			let hasContent = false;

			try {
				const resp = await fetch('https://blogapi.upxuu.com/summarize', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ articleUrl: window.location.href }),
				});
				if (!resp.ok) throw new Error('http ' + resp.status);

				const reader = resp.body?.getReader();
				if (!reader) throw new Error('no reader');

				const decoder = new TextDecoder();
				let buf = '';

				while (true) {
					const { done, value } = await reader.read();
					if (done) break;

					buf += decoder.decode(value, { stream: true });
					const lines = buf.split('\n');
					buf = lines.pop() || '';

					for (const line of lines) {
						if (!line.startsWith('data: ')) continue;
						const data = line.slice(6).trim();
						if (data === '[DONE]') continue;
						try {
							const d = JSON.parse(data).choices?.[0]?.delta;
							if (d?.reasoning_content && !hasContent) {
								if (box.classList.contains('hidden')) box.classList.remove('hidden');
								thinkingText.textContent += d.reasoning_content;
							}
							if (d?.content) {
								if (!hasContent) {
									hasContent = true;
									thinkingText.parentElement!.classList.add('collapsed');
									loadingEl.classList.add('hidden');
									box.classList.remove('hidden');
									resultEl.classList.remove('hidden');
								}
								full += d.content;
								resultEl.textContent = full;
							}
						} catch {}
					}
				}
				if (full) sessionStorage.setItem(cacheKey, full);
			} catch {
				loadingEl.classList.add('hidden');
				box.classList.remove('hidden');
				resultEl.innerHTML = '<span class="opacity-50 font-mono text-xs">⚠ 摘要生成失败</span>';
				resultEl.classList.remove('hidden');
			}
		})();
	})();
</script>
