<script>
	const VISIT_SESSION_KEY = 'blog_visit_flag';
	let hasShownToast = false;

	function createWelcomeToast() {
		const toast = document.createElement('div');
		toast.id = 'welcome-toast';
		toast.className = 'fixed bottom-4 left-4 z-50 translate-y-full transition-transform duration-500 ease-out';
		toast.innerHTML = `
			<div class="bg-gradient-to-r from-blue-50 to-cyan-50 dark:from-blue-900/30 dark:to-cyan-900/30 border border-blue-200 dark:border-blue-700 rounded-lg shadow-sm">
				<div class="flex items-center gap-2 px-3 h-8">
					<span class="text-xs">👋</span>
					<span id="welcome-message" class="text-xs text-gray-700 dark:text-gray-200 whitespace-nowrap">正在加载...</span>
					<span class="text-gray-300 dark:text-gray-600 text-xs">|</span>
					<span id="welcome-stats" class="text-xs text-gray-600 dark:text-gray-400 whitespace-nowrap"></span>
					<div class="flex items-center gap-1.5 ml-1 shrink-0">
						<a href="https://qun.qq.com/universal-share/share?ac=1&authKey=NZ9BP%2BPT44nu34JWAL4Jdz25Bq7ueQoOfOqA4iYPT1JvQKYktml43kgBTMfqTkNl&busi_data=eyJncm91cENvZGUiOiIxMTAzMjMyNDIyIiwidG9rZW4iOiJTZDh2RmhWbXFTL3ZHbVBXeXhJZndQTVcrOUlhNXRSNlczVG1GNUIzQnlQejFZSThWYStSSEVEWUtDcHdHSTM3IiwidWluIjoiMzY5Nzc3MzQxNiJ9&data=HZcezojmJTU_U4qRqv_3ODAb7vm86b6wP8YEp9Stz5b4EzngKNFllXJneyVO7qr4u-plsM84FyvpZl6kkuyZgg&svctype=4&tempid=h5_group_info" target="_blank" rel="noopener noreferrer" class="text-[10px] font-medium text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 transition-colors shrink-0">QQ群</a>
						<span class="text-gray-300 dark:text-gray-600 text-[10px]">|</span>
						<a href="https://github.com/ImUpXuu/myblog/issues/66" class="text-[10px] font-medium text-green-500 hover:text-green-600 dark:text-green-400 dark:hover:text-green-300 transition-colors shrink-0">订阅</a>
						<span class="text-gray-300 dark:text-gray-600 text-[10px]">|</span>
						<a href="javascript:void(0)" onclick="copyRssLink()" class="text-[10px] font-medium text-orange-500 hover:text-orange-600 dark:text-orange-400 dark:hover:text-orange-300 transition-colors shrink-0">RSS</a>
						<button
							onclick="closeWelcomeToast()"
							class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors shrink-0 ml-0.5"
							aria-label="关闭"
						>
							<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>
		`;
		document.body.appendChild(toast);
		return toast;
	}

	function closeWelcomeToast() {
		const toast = document.getElementById('welcome-toast');
		if (toast) {
			toast.classList.add('translate-y-full');
			setTimeout(() => {
				toast.remove();
			}, 500);
		}
	}

	async function fetchLocation() {
		try {
			const response = await fetch('https://v2.xxapi.cn/api/ip');
			const data = await response.json();

			if (data.code === 200 && data.data) {
				const location = data.data;
				const messageEl = document.getElementById('welcome-message');
				if (messageEl) {
					messageEl.textContent = `HI！来自${location.address}的访客`;
				}
			}
		} catch {
			const messageEl = document.getElementById('welcome-message');
			if (messageEl) {
				messageEl.textContent = 'HI！来自远方的访客';
			}
		}
	}

	async function fetchStats() {
		try {
			const response = await fetch('https://upxuu.com/statsapi/alltime');
			const data = await response.json();

			if (data && data.pageviews !== undefined) {
				const statsEl = document.getElementById('welcome-stats');
				if (statsEl) {
					statsEl.textContent = `你是第 ${data.pageviews.toLocaleString()} 位浏览者`;
				}
			}
		} catch {
			const statsEl = document.getElementById('welcome-stats');
			if (statsEl) {
				statsEl.textContent = '欢迎来到 UpXuu 的博客';
			}
		}
	}

	async function showWelcomeToast() {
		if (hasShownToast) return;

		const toast = createWelcomeToast();

		setTimeout(() => {
			toast.classList.remove('translate-y-full');
		}, 100);

		hasShownToast = true;

		await Promise.all([fetchLocation(), fetchStats()]);

		setTimeout(() => {
			closeWelcomeToast();
		}, 5000);
	}

	function shouldShowWelcome() {
		return !sessionStorage.getItem(VISIT_SESSION_KEY);
	}

	function markAsVisited() {
		sessionStorage.setItem(VISIT_SESSION_KEY, 'true');
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', async () => {
			if (shouldShowWelcome()) {
				markAsVisited();
				await showWelcomeToast();
			}
		});
	} else {
		if (shouldShowWelcome()) {
			markAsVisited();
			await showWelcomeToast();
		}
	}

	(window as any).closeWelcomeToast = closeWelcomeToast;

	(window as any).copyRssLink = async () => {
		try {
			await navigator.clipboard.writeText('https://upxuu.com/rss.xml');
		} catch {
			const input = document.createElement('input');
			input.value = 'https://upxuu.com/rss.xml';
			document.body.appendChild(input);
			input.select();
			document.execCommand('copy');
			document.body.removeChild(input);
		}
	};
</script>
